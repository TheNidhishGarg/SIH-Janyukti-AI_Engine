# --- App ---
DEBUG=true
CORS_ORIGINS=*

# --- Database ---
# SQLite needs no setup. For deployment:
#   DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/janyukti
DATABASE_URL=sqlite+aiosqlite:///./janyukti.db

# --- Auth ---
# Must be at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DEV_OTP=123456

# --- AI engine ---
# Optional. Without a key the heuristic engine is used and everything still works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Set false to skip the model download and use the hashing fallback.
USE_LOCAL_EMBEDDINGS=true
# Auto-flag bar for duplicates, calibrated for MiniLM (see docs/AI_ENGINE.md).
# Raise it to flag fewer, lower it to catch more.
DUPLICATE_SIMILARITY_THRESHOLD=0.50
MATCH_TOP_K=5

# --- Flutter app integration ---
# The app signs in with Firebase and calls /ai with its ID token.
FIREBASE_PROJECT_ID=janyukti-1cbba
# off: accept unauthenticated /ai calls (local development only).
# required: verify the Firebase ID token on every /ai call.
FIREBASE_AUTH_MODE=off

# --- Media ---
# Leave blank to store uploads on local disk under ./uploads
CLOUDINARY_URL=
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
